# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TZ=Africa/Casablanca
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cod_user:cod_password@localhost:5432/cod_db

# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# ─── Owner WhatsApp ───────────────────────────────────────────────────────────
MY_WHATSAPP_NUMBER=212600000000

# ─── Google Sheets ────────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_SERVICE_ACCOUNT_KEY=/app/config/service-account.json

# ─── OzonExpress ─────────────────────────────────────────────────────────────
OZON_API_URL=https://api.ozonexpress.com/v1
OZON_API_KEY=your_ozon_api_key
OZON_API_SECRET=your_ozon_api_secret

# ─── Claude AI ───────────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Reminder Schedule (HH:MM, Africa/Casablanca) ────────────────────────────
REMINDER_TIME_1=10:00
REMINDER_TIME_2=14:00
REMINDER_TIME_3=20:00

# ─── Customer Notification Window ────────────────────────────────────────────
CLIENT_NOTIFY_START_HOUR=9
CLIENT_NOTIFY_END_HOUR=20

# ─── Internal API Security ───────────────────────────────────────────────────
INTERNAL_WEBHOOK_SECRET=your_internal_secret_here
